// Porte de interno/instalador/instalador_test.go do pacote-go. O Instalador roda no modo
// simulado: clones e chamadas ao npm são registrados em vez de executados.
importar { Verificador } de "./verificador"
importar { VersaoRegistro } de "../fontes/modelos"
importar { Trava, PacoteTravado, lerTrava, gravarTrava, nomeArquivoTrava } de "../fontes/trava"
importar { Fonte, FonteMemoria } de "../fontes/resolvedor"
importar { Instalador, OpcoesInstalacao, Especificacao, separarEspecificacao, especificacaoNpm, nomeManifesto } de "../fontes/instalador"

var v = Verificador("instalador")
var arquivos = importar("arquivos")

var base = arquivos.juntarCaminhos(arquivos.diretorioAtual(), "tmp-instalador-teste")
arquivos.remover(base)
arquivos.criarDiretorio(base)

funcao versao(numero: texto, realizacoes: texto[], dependencias: texto[]): VersaoRegistro {
    var registro = VersaoRegistro(numero)
    registro.tagGitHub = "v" + numero
    registro.hashCommit = "hash-" + numero
    para cada realizacao em realizacoes {
        registro.realizacoes.adicionar(realizacao)
    }
    para cada dependencia em dependencias {
        var posicao: inteiro = dependencia.encontrar("@")
        var nome: texto = dependencia.subtexto(0, posicao)
        var restricao: texto = dependencia.subtexto(posicao + 1, dependencia.tamanho())
        registro.dependencias[nome] = restricao
    }
    registro.nivelVerificacao = "verificado"
    retorna registro
}

funcao fonteExemplo(nivelTexto201: texto): Fonte {
    var nenhuma: texto[] = []
    var fonte = FonteMemoria()
    fonte.adicionarVersao("web", versao("1.0.0", ["node"], ["json@^1.0.0", "texto@~2.0.0"]))
    var json = versao("1.1.0", ["node", "llvm"], nenhuma)
    json.pacoteNpm = "@designliquido/delegua-json"
    fonte.adicionarVersao("json", json)
    var texto201 = versao("2.0.1", ["node", "llvm", "cgd"], nenhuma)
    texto201.nivelVerificacao = nivelTexto201
    fonte.adicionarVersao("texto", texto201)
    fonte.adicionarVersao("texto", versao("2.1.0", ["node", "llvm", "cgd"], nenhuma))
    retorna fonte
}

// Instalador simulado num diretório próprio, com o pacoteca.jsonc dado ("" para nenhum).
funcao novoInstaladorTeste(nome: texto, fonte: Fonte, realizacao: texto, manifesto: texto): Instalador {
    var arquivos = importar("arquivos")
    var opcoes = OpcoesInstalacao()
    opcoes.realizacao = realizacao
    opcoes.diretorio = arquivos.juntarCaminhos(arquivos.juntarCaminhos(arquivos.diretorioAtual(), "tmp-instalador-teste"), nome)
    arquivos.criarDiretorio(opcoes.diretorio)
    se manifesto != "" {
        arquivos.escreverTexto(arquivos.juntarCaminhos(opcoes.diretorio, nomeManifesto()), manifesto)
    }
    var instalador = Instalador(fonte, opcoes)
    instalador.simulado = verdadeiro
    instalador.imprimir = falso
    retorna instalador
}

funcao erroAoInstalar(instalador: Instalador, especificacao: texto): texto {
    tente {
        se especificacao == "" {
            instalador.instalarDependencias()
        } senao {
            instalador.instalarPacote(especificacao)
        }
    } pegue (erro: Excecao) {
        retorna erro.mensagem
    }
    retorna ""
}

funcao caminhoTrava(instalador: Instalador): texto {
    var arquivos = importar("arquivos")
    var caminho: texto = arquivos.juntarCaminhos(instalador.opcoes.diretorio, nomeArquivoTrava())
    retorna caminho
}

// TestInstalarDependenciasTransitivas
var transitivas = novoInstaladorTeste("transitivas", fonteExemplo("verificado"), "", "{\n  // comentário\n  \"nome\": \"app\", \"versao\": \"0.1.0\", \"realizacoes\": [\"node\"],\n  \"dependencias\": { \"web\": \"^1.0.0\" }\n}")
transitivas.instalarDependencias()
var clonesTransitivas: texto[] = transitivas.clones
var obtidos = clonesTransitivas.juntar("\n")
var esperados: texto[] = ["pacotes/llvm/json v1.1.0@hash-1.1.0", "pacotes/cgd/texto v2.0.1@hash-2.0.1", "pacotes/llvm/texto v2.0.1@hash-2.0.1", "pacotes/node/texto v2.0.1@hash-2.0.1", "pacotes/node/web v1.0.0@hash-1.0.0"]
para cada esperado em esperados {
    v.contem(obtidos, esperado, "clone esperado")
}
v.verificar(clonesTransitivas.tamanho() == esperados.tamanho(), "quantidade de clones: " + texto(clonesTransitivas.tamanho()))
var npmTransitivas: texto[] = transitivas.chamadasNpm
v.igual(npmTransitivas.juntar("|"), "install @designliquido/delegua-json@1.1.0", "npm para o pacote com pacoteNpm")
var travaTransitivas = lerTrava(caminhoTrava(transitivas))
var nomesTrava: texto[] = travaTransitivas.nomes()
var textoTravado: PacoteTravado = travaTransitivas.obter("texto")
v.verificar(nomesTrava.tamanho() == 3 e textoTravado.hashCommit == "hash-2.0.1", "pacoteca.lock gravado")

// TestInstalarComRealizacao
var soLlvm = novoInstaladorTeste("realizacao", fonteExemplo("verificado"), "llvm", "{\"nome\": \"app\", \"dependencias\": {\"web\": \"^1.0.0\"}}")
soLlvm.instalarDependencias()
var clonesLlvm: texto[] = soLlvm.clones
para cada clone em clonesLlvm {
    v.verificar(clone.comecaCom("pacotes/llvm/"), "clone fora de llvm: " + clone)
}
var npmLlvm: texto[] = soLlvm.chamadasNpm
v.verificar(npmLlvm.tamanho() == 0, "npm não é chamado para llvm")
v.contem(soLlvm.textoSaida, "web@1.0.0 ignorado", "aviso de pacote ignorado")
// Pedido explícito de um pacote sem a realização: erro.
v.contem(erroAoInstalar(soLlvm, "web"), "não suporta a realização 'llvm'", "pedido explícito sem a realização")

// TestInstalarCongeladoFalhaComTravaDesatualizada
var congelado = novoInstaladorTeste("congelado", fonteExemplo("verificado"), "", "{\"nome\": \"app\", \"dependencias\": {\"texto\": \"^2.0.0\"}}")
congelado.opcoes.congelado = verdadeiro
v.contem(erroAoInstalar(congelado, ""), "desatualizado", "--congelado com trava desatualizada")
var clonesCongelado: texto[] = congelado.clones
v.verificar(clonesCongelado.tamanho() == 0, "nada é instalado com trava desatualizada")
congelado.opcoes.congelado = falso
congelado.instalarDependencias()
congelado.opcoes.congelado = verdadeiro
v.igual(erroAoInstalar(congelado, ""), "", "--congelado com trava em dia")

// TestInstalarRespeitaTrava
var respeita = novoInstaladorTeste("respeita-trava", fonteExemplo("verificado"), "", "{\"nome\": \"app\", \"dependencias\": {\"texto\": \"^2.0.0\"}}")
var travaPrevia = Trava()
var textoPrevio = PacoteTravado("2.0.1", "hash-2.0.1")
textoPrevio.tag = "v2.0.1"
travaPrevia.definir("texto", textoPrevio)
gravarTrava(travaPrevia, caminhoTrava(respeita))
respeita.instalarDependencias()
var clonesRespeita: texto[] = respeita.clones
var primeiroClone: texto = clonesRespeita[0]
v.contem(primeiroClone, "v2.0.1@hash-2.0.1", "mantém a 2.0.1 da trava, mesmo havendo 2.1.0")

// TestInstalarPacoteSemManifesto
var semManifesto = novoInstaladorTeste("sem-manifesto", fonteExemplo("verificado"), "node", "")
semManifesto.instalarPacote("texto@~2.0.0")
var clonesSem: texto[] = semManifesto.clones
v.igual(clonesSem.juntar("|"), "pacotes/node/texto v2.0.1@hash-2.0.1", "clone sem manifesto")
v.verificar(nao arquivos.existe(caminhoTrava(semManifesto)), "sem pacoteca.jsonc, o pacoteca.lock não é gravado")
v.contem(semManifesto.textoSaida, "\"texto\": \"^2.0.1\"", "sugestão de dependência sem manifesto")

// TestInstalarPacoteNaoDeclaradoSugereLinha
var naoDeclarado = novoInstaladorTeste("nao-declarado", fonteExemplo("verificado"), "node", "{\"nome\": \"app\", \"dependencias\": {\"texto\": \"~2.0.0\"}}")
naoDeclarado.instalarPacote("web")
v.contem(naoDeclarado.textoSaida, "\"web\": \"^1.0.0\"", "sugestão de linha para pacote não declarado")
var travaNaoDeclarado = lerTrava(caminhoTrava(naoDeclarado))
v.verificar(travaNaoDeclarado.contem("texto"), "a trava continua incluindo as dependências já declaradas")

// TestAvisoDeVerificacao
var aviso = novoInstaladorTeste("aviso", fonteExemplo("em_analise"), "node", "")
aviso.instalarPacote("texto@2.0.1")
v.contem(aviso.textoSaida, "nível: em_analise", "aviso de verificação")

// Manifesto inválido
var invalido = novoInstaladorTeste("manifesto-invalido", fonteExemplo("verificado"), "", "{ /* aberto")
v.contem(erroAoInstalar(invalido, ""), "erro ao analisar pacoteca.jsonc", "pacoteca.jsonc inválido")
var ausente = novoInstaladorTeste("manifesto-ausente", fonteExemplo("verificado"), "", "")
v.contem(erroAoInstalar(ausente, ""), "pacoteca.jsonc não encontrado", "instalar sem pacoteca.jsonc")

// TestEspecificacaoNpm
v.igual(especificacaoNpm("@designliquido/delegua-json", "1.0.0"), "@designliquido/delegua-json@1.0.0", "npm com escopo")
v.igual(especificacaoNpm("@designliquido/delegua-json@0.4.0", "1.0.0"), "@designliquido/delegua-json@0.4.0", "npm com escopo e versão")
v.igual(especificacaoNpm("lodash", "2.0.0"), "lodash@2.0.0", "npm sem escopo")
v.igual(especificacaoNpm("lodash@^4", "2.0.0"), "lodash@^4", "npm sem escopo com versão")

// TestSepararEspecificacao
var casos: texto[] = ["mat", "mat|", "mat@^1.2.0", "mat|^1.2.0", " mat @ ~1 ", "mat|~1", "mat@>=1 <2", "mat|>=1 <2"]
para (var i = 0; i < casos.tamanho(); i = i + 2) {
    var entrada: texto = casos[i]
    var esperado: texto = casos[i + 1]
    var separada = separarEspecificacao(entrada)
    v.igual(separada.nome + "|" + separada.restricao, esperado, "separarEspecificacao(\"" + entrada + "\")")
}

arquivos.remover(base)
v.finalizar()
